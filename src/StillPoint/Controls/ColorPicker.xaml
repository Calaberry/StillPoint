<UserControl x:Class="StillPoint.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="248"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="HueSpectrumBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0.000" Color="#FFFF0000" />
            <GradientStop Offset="0.167" Color="#FFFFFF00" />
            <GradientStop Offset="0.333" Color="#FF00FF00" />
            <GradientStop Offset="0.500" Color="#FF00FFFF" />
            <GradientStop Offset="0.667" Color="#FF0000FF" />
            <GradientStop Offset="0.833" Color="#FFFF00FF" />
            <GradientStop Offset="1.000" Color="#FFFF0000" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WhiteFadeBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#FFFFFFFF" />
            <GradientStop Offset="1" Color="#00FFFFFF" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BlackFadeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#00000000" />
            <GradientStop Offset="1" Color="#FF000000" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <StackPanel Margin="14">
        <!-- saturation / value plane -->
        <Border x:Name="PlaneHost" Height="140" CornerRadius="7" ClipToBounds="True"
                Background="#FF1F2328"
                MouseLeftButtonDown="OnPlaneMouseDown"
                MouseMove="OnPlaneMouseMove"
                MouseLeftButtonUp="OnPlaneMouseUp"
                Cursor="Cross">
            <Grid>
                <Rectangle x:Name="HueLayer" Fill="#FFFF0000" />
                <Rectangle Fill="{DynamicResource WhiteFadeBrush}" />
                <Rectangle Fill="{DynamicResource BlackFadeBrush}" />
                <Canvas x:Name="PlaneCanvas" Background="Transparent">
                    <Ellipse x:Name="PlaneThumb" Width="13" Height="13" Stroke="#FFFFFFFF" StrokeThickness="2"
                             IsHitTestVisible="False">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.55" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>
        </Border>

        <!-- hue strip -->
        <Border x:Name="HueHost" Height="14" Margin="0,12,0,0" CornerRadius="7" ClipToBounds="True"
                MouseLeftButtonDown="OnHueMouseDown"
                MouseMove="OnHueMouseMove"
                MouseLeftButtonUp="OnHueMouseUp"
                Cursor="Hand">
            <Grid>
                <Rectangle Fill="{DynamicResource HueSpectrumBrush}" />
                <Canvas x:Name="HueCanvas" Background="Transparent">
                    <Ellipse x:Name="HueThumb" Width="16" Height="16" Stroke="#FFFFFFFF" StrokeThickness="2"
                             Fill="Transparent" IsHitTestVisible="False">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.55" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>
        </Border>

        <!-- value row: preview, hex, done -->
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="PreviewChip" Width="26" Height="26" CornerRadius="13"
                    BorderBrush="#22000000" BorderThickness="1" VerticalAlignment="Center" />

            <Border Grid.Column="1" Margin="10,0,10,0" Height="30" CornerRadius="7"
                    Background="#FFECECEE" VerticalAlignment="Center">
                <TextBox x:Name="HexBox" BorderThickness="0" Background="Transparent"
                         VerticalContentAlignment="Center" Padding="9,0" FontFamily="Consolas"
                         FontSize="12.5" Foreground="#FF1C1C1E" MaxLength="7"
                         KeyDown="OnHexKeyDown" LostFocus="OnHexLostFocus" />
            </Border>

            <Button Grid.Column="2" x:Name="DoneButton" Content="完成" Height="30" MinWidth="56"
                    Padding="14,0" Click="OnDoneClick" FontSize="13"
                    Foreground="#FFFFFFFF">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#FF2C7BE5" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
