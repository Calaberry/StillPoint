<Window x:Class="StillPoint.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StillPoint.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="StillPoint"
        Icon="pack://application:,,,/Resources/StillPoint.ico"
        Width="760" Height="820"
        MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Topmost="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Header ============ -->
        <Grid Grid.Row="0" Margin="24,20,16,14" Background="Transparent"
              MouseLeftButtonDown="OnHeaderDrag">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="StillPoint" Style="{StaticResource DisplayTitle}" />
                <TextBlock Text="Comfort Overlay · 减少 3D 眩晕的点阵浮层"
                           Style="{StaticResource Caption}" Margin="0,3,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="StatusPill" Style="{StaticResource StatusPill}" Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource SuccessBrush}"
                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="StatusLabel" Text="运行中" Style="{StaticResource StatusText}" />
                    </StackPanel>
                </Border>

                <CheckBox x:Name="EnableToggle" Style="{StaticResource ToggleSwitch}"
                          Content="启用" VerticalAlignment="Center"
                          Checked="OnEnableChanged" Unchecked="OnEnableChanged" />

                <Border Width="1" Height="20" Background="{DynamicResource DividerBrush}" Margin="16,0,10,0" />

                <Button Style="{StaticResource TitleBarButton}" ToolTip="最小化" Click="OnMinimiseClick"
                        AutomationProperties.Name="最小化">
                    <Path Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.2"
                          Data="M 4,8 L 12,8" />
                </Button>
                <Button Style="{StaticResource TitleBarButton}" ToolTip="关闭窗口（点阵继续运行）" Click="OnCloseClick"
                        AutomationProperties.Name="关闭" AutomationProperties.AutomationId="CloseButton">
                    <Path Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.2"
                          Data="M 4.5,4.5 L 11.5,11.5 M 11.5,4.5 L 4.5,11.5" />
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Height="1" Background="{DynamicResource DividerBrush}" />

        <!-- ============ Body ============ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0" Focusable="False">
            <StackPanel Margin="24,0,18,4">

                <!-- Preview -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="预览" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="与实际浮层使用同一套布局与渲染参数，所见即所在。"
                                           Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="BackdropGame" Style="{StaticResource Segment}"
                                                 Content="游戏场景" GroupName="Backdrop" IsChecked="True" Tag="game"
                                                 Checked="OnBackdropChanged" />
                                    <RadioButton x:Name="BackdropLight" Style="{StaticResource Segment}"
                                                 Content="浅色" GroupName="Backdrop" Tag="light"
                                                 Checked="OnBackdropChanged" />
                                    <RadioButton x:Name="BackdropDark" Style="{StaticResource Segment}"
                                                 Content="深色" GroupName="Backdrop" Tag="dark"
                                                 Checked="OnBackdropChanged" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,14,0,0" Height="236" CornerRadius="9" ClipToBounds="True"
                                Background="{DynamicResource ControlBackgroundBrush}">
                            <controls:DotPreview x:Name="Preview" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="外观" Style="{StaticResource SectionTitle}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="颜色" Style="{StaticResource FieldLabel}" />
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel x:Name="SwatchHost" Orientation="Horizontal" />
                                <Button x:Name="CustomColourButton" Style="{StaticResource BaseButton}" Height="26" Padding="9,0,11,0"
                                        Margin="4,0,8,0" Click="OnCustomColourClick">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="CustomChip" Width="12" Height="12" VerticalAlignment="Center"
                                                 Fill="{DynamicResource SwatchChipBrush}"
                                                 Stroke="{DynamicResource SwatchChipStrokeBrush}" StrokeThickness="0.8" />
                                        <TextBlock Text="自选…" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Content="恢复默认" Style="{StaticResource GhostButton}" Height="26" Padding="8,0"
                                        Click="OnResetColourClick" />
                            </WrapPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="点阵大小" Style="{StaticResource FieldLabel}" />
                            <Slider x:Name="DotSizeSlider" AutomationProperties.Name="点阵大小" Grid.Column="1" Style="{StaticResource FlatSlider}"
                                    Minimum="0.5" Maximum="2.5" SmallChange="0.05" LargeChange="0.1"
                                    ValueChanged="OnDotSizeChanged" />
                            <TextBlock x:Name="DotSizeValue" Grid.Column="2" Text="100%" Style="{StaticResource ValueLabel}" />
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="光晕强度" Style="{StaticResource FieldLabel}" />
                            <Slider x:Name="GlowSlider" AutomationProperties.Name="光晕强度" Grid.Column="1" Style="{StaticResource FlatSlider}"
                                    Minimum="0" Maximum="0.45" SmallChange="0.01" LargeChange="0.02"
                                    ValueChanged="OnGlowChanged" />
                            <TextBlock x:Name="GlowValue" Grid.Column="2" Text="13%" Style="{StaticResource ValueLabel}" />
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="不透明度" Style="{StaticResource FieldLabel}" />
                            <Slider x:Name="OpacitySlider" AutomationProperties.Name="不透明度" Grid.Column="1" Style="{StaticResource FlatSlider}"
                                    Minimum="0.15" Maximum="1" SmallChange="0.01" LargeChange="0.05"
                                    ValueChanged="OnOpacityChanged" />
                            <TextBlock x:Name="OpacityValue" Grid.Column="2" Text="94%" Style="{StaticResource ValueLabel}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="界面" Style="{StaticResource FieldLabel}" />
                            <Border Grid.Column="1" Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ThemeLight" Style="{StaticResource Segment}" Content="浅色"
                                                 AutomationProperties.AutomationId="ThemeLight"
                                                 GroupName="UiTheme" Tag="light" Checked="OnThemeChanged" />
                                    <RadioButton x:Name="ThemeDark" Style="{StaticResource Segment}" Content="深色"
                                                 AutomationProperties.AutomationId="ThemeDark"
                                                 GroupName="UiTheme" Tag="dark" Checked="OnThemeChanged" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Layout -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="布局" Style="{StaticResource SectionTitle}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="整体缩放" Style="{StaticResource FieldLabel}" />
                            <Slider x:Name="ScaleSlider" AutomationProperties.Name="整体缩放" Grid.Column="1" Style="{StaticResource FlatSlider}"
                                    Minimum="0.6" Maximum="1.5" SmallChange="0.01" LargeChange="0.05"
                                    ValueChanged="OnScaleChanged" />
                            <TextBlock x:Name="ScaleValue" Grid.Column="2" Text="100%" Style="{StaticResource ValueLabel}" />
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="间距" Style="{StaticResource FieldLabel}" />
                            <Slider x:Name="SpacingSlider" AutomationProperties.Name="间距" Grid.Column="1" Style="{StaticResource FlatSlider}"
                                    Minimum="0.85" Maximum="1.15" SmallChange="0.01" LargeChange="0.02"
                                    ValueChanged="OnSpacingChanged" />
                            <TextBlock x:Name="SpacingValue" Grid.Column="2" Text="100%" Style="{StaticResource ValueLabel}" />
                        </Grid>

                        <Grid Margin="0,10,0,0" Visibility="Collapsed" x:Name="SeparateSpacingPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="水平间距" Style="{StaticResource FieldLabel}" />
                            <Slider x:Name="SpacingHSlider" AutomationProperties.Name="水平间距" Grid.Column="1" Style="{StaticResource FlatSlider}"
                                    Minimum="0.85" Maximum="1.15" SmallChange="0.01" LargeChange="0.02"
                                    ValueChanged="OnSpacingHChanged" />
                            <TextBlock x:Name="SpacingHValue" Grid.Column="2" Text="100%" Style="{StaticResource ValueLabel}" />
                        </Grid>

                        <Grid Margin="0,6,0,0" Visibility="Collapsed" x:Name="SeparateSpacingPanelV">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="垂直间距" Style="{StaticResource FieldLabel}" />
                            <Slider x:Name="SpacingVSlider" AutomationProperties.Name="垂直间距" Grid.Column="1" Style="{StaticResource FlatSlider}"
                                    Minimum="0.85" Maximum="1.15" SmallChange="0.01" LargeChange="0.02"
                                    ValueChanged="OnSpacingVChanged" />
                            <TextBlock x:Name="SpacingVValue" Grid.Column="2" Text="100%" Style="{StaticResource ValueLabel}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="SeparateSpacingToggle" Grid.Column="0" Style="{StaticResource ToggleSwitch}"
                                      Content="水平与垂直分别调整" VerticalAlignment="Center"
                                      Checked="OnSeparateSpacingChanged" Unchecked="OnSeparateSpacingChanged" />
                            <Button x:Name="ResetLayoutButton" Grid.Column="1" Content="恢复默认布局"
                                    Style="{StaticResource BaseButton}" Click="OnResetLayoutClick" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Runtime -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="运行与兼容性" Style="{StaticResource SectionTitle}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="OverlayStateText" Text="浮层已显示" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="OverlayDetailText" Text="—" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button x:Name="OverlayToggleButton" Grid.Column="1" Content="隐藏点阵"
                                    Style="{StaticResource BaseButton}" Click="OnToggleOverlayClick" />
                        </Grid>

                        <Border Style="{StaticResource Divider}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="全局快捷键" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="HotkeyHint" Text="仅在设置窗口之外生效，不影响游戏按键"
                                           Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="HotkeyButton" Content="Ctrl+Alt+D" Style="{StaticResource BaseButton}"
                                        MinWidth="104" Click="OnHotkeyButtonClick" />
                                <CheckBox x:Name="HotkeyToggle" Style="{StaticResource ToggleSwitch}" Content="启用"
                                          Margin="12,0,0,0" VerticalAlignment="Center"
                                          Checked="OnHotkeyToggleChanged" Unchecked="OnHotkeyToggleChanged" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Divider}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="当前前台窗口" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="ForegroundText" Text="—" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="FullscreenBadge" Text="窗口模式" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Divider}" />

                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                                       Text="• 窗口化与无边框全屏：浮层会稳定覆盖在游戏之上，鼠标可正常点击游戏。" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                                       Text="• 独占全屏：Windows 绕过桌面合成，系统级浮层通常无法覆盖，请把游戏改为「无边框 / 窗口化全屏」。" />
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="• 浮层不注入、不修改游戏文件、不读写游戏内存，也不做任何屏幕采集。" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Height="6" Background="Transparent" />
            </StackPanel>
        </ScrollViewer>

        <!-- ============ Footer ============ -->
        <Grid Grid.Row="3" Margin="24,10,18,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="VersionText" Text="StillPoint 0.1.0" Style="{StaticResource Caption}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="重置全部设置" Style="{StaticResource GhostButton}" Click="OnResetAllClick" />
                <Button Content="退出 StillPoint" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                        Click="OnExitClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
