<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===== Typography (shared with the light palette; a swap must keep every key present) ===== -->
    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <sys:Double x:Key="BodyFontSize">13.5</sys:Double>
    <sys:Double x:Key="CaptionFontSize">12</sys:Double>

    <!-- ===== Dark palette ===== -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1B1B1E" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#232327" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F5" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A5A5AE" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7C7C86" />
    <SolidColorBrush x:Key="DividerBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#303035" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#393940" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#43434B" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4B90F0" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2E4B90F0" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#48B584" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D9A23C" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E4695F" />

    <!-- Neutral chip shown behind colour samples so light dots stay visible on a dark card too. -->
    <SolidColorBrush x:Key="SwatchChipBrush" Color="#0F0F11" />
    <SolidColorBrush x:Key="SwatchChipStrokeBrush" Color="#33FFFFFF" />

    <!-- Preview stage around the virtual screen. -->
    <SolidColorBrush x:Key="PreviewFrameBrush" Color="#141416" />
    <SolidColorBrush x:Key="PreviewScreenStrokeBrush" Color="#30FFFFFF" />

</ResourceDictionary>
