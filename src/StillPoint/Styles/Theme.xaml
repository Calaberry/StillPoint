<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===== Typography ===== -->
    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <sys:Double x:Key="BodyFontSize">13.5</sys:Double>
    <sys:Double x:Key="CaptionFontSize">12</sys:Double>

    <!-- ===== Light palette (default) ===== -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F6F6F7" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#10000000" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1C1C1E" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6E6E73" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9A9AA0" />
    <SolidColorBrush x:Key="DividerBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#ECECEE" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#E3E3E6" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#D8D8DC" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2C7BE5" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F2C7BE5" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#2FA36B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#C98A15" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D9534F" />

    <!-- Neutral chip shown behind colour samples so light dots stay visible on a white card. -->
    <SolidColorBrush x:Key="SwatchChipBrush" Color="#2B3037" />
    <SolidColorBrush x:Key="SwatchChipStrokeBrush" Color="#33FFFFFF" />

    <!-- Preview stage around the virtual screen. -->
    <SolidColorBrush x:Key="PreviewFrameBrush" Color="#F3F3F5" />
    <SolidColorBrush x:Key="PreviewScreenStrokeBrush" Color="#14000000" />

</ResourceDictionary>
